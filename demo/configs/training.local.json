{
  "addrs": ["127.0.0.1:40000", "127.0.0.1:40001", "127.0.0.1:40002"],
  "algorithm": { "strategy_switch": { "nservers": 1, "synchronizer": "non_blocking", "store": "blocking" } },
  "dataset": {
    "src": { "local": {
      "samples_path": "datasets/mnist/mnist_train_samples.bin",
      "labels_path": "datasets/mnist/mnist_train_labels_smooth.bin"
    } },
    "x_size": 784, "y_size": 10
  },
  "optimizer": { "gradient_descent": { "lr": 0.2 } },
  "loss_fn": "cross_entropy",
  "batch_size": 64,
  "max_epochs": 48,
  "offline_epochs": 0,
  "seed": 42
}
