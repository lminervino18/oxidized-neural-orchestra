     "lr": 0.1, "loss_fn": "cross_entropy", "seed": 42, "eval": true,
     "notes": "AR 3w, global batch 3x80=240"},

    {"label": "Bg_ps_n3", "dataset": "mnist", "model": "nielsen", "strategy": "parameter_server",
