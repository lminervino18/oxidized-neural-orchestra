{
  "name": "example_ar_vs_ps",
  "runs": [
    {
      "label": "ar3_nielsen",
      "dataset": "mnist",
      "model": "nielsen",
      "strategy": "all_reduce",
      "workers": 3,
      "servers": 0,
      "batch_size": 16,
      "max_epochs": 20,
      "offline_epochs": 0,
      "lr": 0.1,
      "loss_fn": "cross_entropy",
      "seed": 42,
      "eval": true,
      "notes": "all-reduce, 3 workers"
    },
    {
      "label": "ps2x1_nielsen",
      "dataset": "mnist",
      "model": "nielsen",
      "strategy": "parameter_server",
      "workers": 2,
      "servers": 1,
      "batch_size": 16,
      "max_epochs": 20,
      "offline_epochs": 0,
      "lr": 0.1,
      "loss_fn": "cross_entropy",
      "seed": 42,
      "eval": true,
      "notes": "blocking PS (barrier + blocking store), 2 workers + 1 server"
    },
    {
      "label": "switch2x1_nielsen",
      "dataset": "mnist",
      "model": "nielsen",
      "strategy": "strategy_switch",
      "workers": 2,
      "servers": 1,
      "batch_size": 16,
      "max_epochs": 20,
      "offline_epochs": 0,
      "lr": 0.1,
      "loss_fn": "cross_entropy",
      "seed": 42,
      "eval": true,
      "notes": "starts all-reduce then switches to PS"
    },
    {
      "label": "baseline_nielsen",
      "dataset": "mnist",
      "model": "nielsen",
      "strategy": "baseline",
      "workers": 1,
      "servers": 0,
      "batch_size": 16,
      "max_epochs": 20,
      "offline_epochs": 0,
      "lr": 0.1,
      "loss_fn": "cross_entropy",
      "seed": 42,
      "eval": true,
      "notes": "single-process PyTorch reference"
    }
  ]
}
