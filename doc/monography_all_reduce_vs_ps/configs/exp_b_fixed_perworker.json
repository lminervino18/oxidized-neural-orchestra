    {"label": "Bp_ar_n1", "dataset": "mnist", "model": "nielsen", "strategy": "all_reduce",
     "workers": 1, "servers": 0, "batch_size": 64, "max_epochs": 8, "offline_epochs": 0,
     "lr": 0.1, "loss_fn": "cross_entropy", "seed": 42, "eval": false,
     "notes": "AR 1w — single-worker throughput reference"},

    {"label": "Bp_ar_n3", "dataset": "mnist", "model": "nielsen", "strategy": "all_reduce",
     "workers": 3, "servers": 0, "batch_size": 64, "max_epochs": 8, "offline_epochs": 0,
     "lr": 0.1, "loss_fn": "cross_entropy", "seed": 42, "eval": false,
     "notes": "AR 3w"},

    {"label": "Bp_ar_n5", "dataset": "mnist", "model": "nielsen", "strategy": "all_reduce",
     "workers": 5, "servers": 0, "batch_size": 64, "max_epochs": 8, "offline_epochs": 0,
     "lr": 0.1, "loss_fn": "cross_entropy", "seed": 42, "eval": false,
     "notes": "AR 5w"},

    {"label": "Bp_ps_n3", "dataset": "mnist", "model": "nielsen", "strategy": "parameter_server",
