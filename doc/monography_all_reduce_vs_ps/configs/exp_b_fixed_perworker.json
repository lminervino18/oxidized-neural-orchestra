     "lr": 0.1, "loss_fn": "cross_entropy", "seed": 42, "eval": false,
     "notes": "PS 2w+1s"},

    {"label": "Bp_ps_n5", "dataset": "mnist", "model": "nielsen", "strategy": "parameter_server",
